# Production configuration template — placeholder values only.
# Copy to backend/.env on the production host and fill real values via the
# secret manager. NEVER commit the filled file. NEVER paste secrets into chat.

# ============ A. BACKEND SECRETS (server-only, never VITE_) ============
# Required. Long random string. Different from every other environment.
JWT_SECRET_KEY=
# Required. HS256 unless the deploy explicitly configures otherwise.
JWT_ALGORITHM=HS256
# Required. Full SQLAlchemy URL with the production database password.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/jansamadhan
# Required only when STORAGE_PROVIDER=supabase. Service-role key, backend-only.
SUPABASE_SERVICE_ROLE_KEY=
# Required only for real AI screening. If empty, AI_PROVIDER must be mock.
AI_API_KEY=
# Required. Brevo private API key for public OTP + workflow email.
BREVO_API_KEY=

# ============ D/G. SUPABASE + DATABASE (production values) ============
# Required when STORAGE_PROVIDER=supabase. Project URL (trailing /rest/v1 optional).
SUPABASE_URL=https://<project-ref>.supabase.co
# Private bucket name. Must already exist; backend never creates buckets.
SUPABASE_ATTACHMENTS_BUCKET=attachments
# storage backend selector: local | supabase. Production target: supabase.
STORAGE_PROVIDER=supabase

# ============ E. BREVO (public email only; never government login) ============
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JanSamadhan
BREVO_SMS_SENDER=JanSamadhan
# Delivery selector: mock | brevo. Production: brevo.
OTP_PROVIDER=brevo
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============ F. OPENROUTER (public submission screening only) ============
# mock (default, no key needed) | openrouter (requires AI_API_KEY above).
AI_PROVIDER=mock
AI_MODEL=openai/gpt-4o-mini

# ============ H. DEPLOYMENT / DOMAIN ============
APP_NAME=JanSamadhan API
APP_VERSION=0.1.0
# Must be production (enables production guards, disables dev OTP echo).
ENVIRONMENT=production
# Must be false in production.
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated exact origins. NEVER "*" with credentials.
# e.g. https://<public-domain>,https://<government-domain>
CORS_ORIGINS=
# Public base URL used for links inside emails (password reset, notifications).
# e.g. https://<public-domain>
FRONTEND_URL=

# ============ B. PUBLIC FRONTEND (frontend/.env.production) ============
# VITE_ values are embedded in the public JS bundle. ONLY safe public config:
# VITE_API_URL=https://<api-domain>/api/v1

# ============ C. GOVERNMENT PORTAL (government-portal/.env.production) ====
# Same rule: ONLY safe public config:
# VITE_API_URL=https://<api-domain>/api/v1
